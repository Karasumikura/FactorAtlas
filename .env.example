# FactorAtlas 环境变量示例
# 复制为 .env 后填入你自己的 key。.env 已被 .gitignore 排除，不会入库。

# ── 行情数据 ─────────────────────────────────────────
# Alpaca：美股日线（免费档够用）https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex          # 免费档只能用 iex

# ── 基本面 ───────────────────────────────────────────
# FMP：行业分类、年度基本面 https://financialmodelingprep.com/
FMP_API_KEY=

# ── 新闻 ─────────────────────────────────────────────
# Marketaux：个股新闻 + 实体情绪分，免费 100 请求/天
MARKETAUX_API_KEY=
# Tavily：宏观市场新闻 https://tavily.com/
TAVILY_API_KEY=

# ── 加密 ─────────────────────────────────────────────
# Binance：K 线公共接口不需要 key；下单需要（默认只走测试网）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── LLM（挖因子提案 + 新闻判断）──────────────────────
# 任何 OpenAI 兼容端点都行；本地 vLLM / Ollama / 中转站均可
QUANT_LLM_BASE_URL=http://127.0.0.1:20128/v1
QUANT_LLM_MODEL=free
NINEROUTER_API_KEY=

# 并发上限：2GB 内存的机器别调高，容易 OOM
QUANT_MAX_LLM_CONCURRENCY=4

# ── 开关 ─────────────────────────────────────────────
# 新闻修正层（1 开 / 0 关）。关掉后交易完全按纯因子执行。
ENABLE_NEWS_ADJUST=1
ENABLE_NEWS_VERDICT=1
